					"default": ""
				},
				"mode": {
					"title": "Modo de exibição",
					"enumNames": [
						"Slider Hero (Carrossel)",
						"Banner Único",
						"Lista de banners",
						"Lista de banners arredondados",
						"Lista em Grade",
						"Caber na tela"
					],
					"enum": [
						"SliderHero",
						"SingleBanner",
						"BannerList",
						"RoundedBannerList",
						"GridList",
						"FitOnScreen"
