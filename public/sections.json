									"type": {
										"title": "Tipo de ação",
										"enumNames": [
											"Nenhum",
											"Abrir Link Externo",
											"Abrir Produto (id ou slug)",
											"Abrir Coleção (Id da coleção)",
											"Abrir Categoria (cate1/cat2/cat3...)",
											"Abrir Busca (termo de busca)",
											"Abrir Landing Page (nome da landing page)",
											"Abrir Seller (id do seller)",
											"Abrir Marca",
											"Abrir Facets"
										],
										"enum": [
											"none",
											"link",
											"product",
											"collection",
											"category",
											"search",
											"page",
											"seller",
											"brand",
											"facets"
										],
										"default": "none"
									},
									"value": {
										"title": "Valor",
										"type": "string"
									},
									"facets": {
										"title": "Busca por facets genéricos",
