						"maxHeight": {
							"type": "string",
							"title": "Altura máxima"
						}
					}
				},
				"autoSize": {
					"title": "Qtd de banners na largura da tela (apenas lista de banners)",
					"enumNames": ["3 e 1/2", "4 e 3/4", "5"],
					"enum": ["three-one-half", "four-three-four", "five"]
				},
				"remoteConfigKey": {
					"title": "Chave de hiperpersonalização Eitri",
					"type": "string",
					"description": "Chave para hiperpersonalização Eitri"
				},
				"startDate": {
					"title": "Exibição programada: Data de início",
					"type": "string",
					"widget": {
						"ui:widget": "date-time"
					}
				},
				"endDate": {
					"title": "Exibição programada: Data de fim",
					"type": "string",
					"widget": {
						"ui:widget": "date-time"
