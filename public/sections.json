										"enumNames": [
											"Desconto: do maior para o menor",
											"Nome: A-Z",
											"Nome: Z-A",
											"Pedidos: do maior para o menor",
											"Preço: do menor para o maior",
											"Preço: do maior para o menor",
											"Lançamento: do mais novo para o mais antigo",
											"Relevância: do maior para o menor"
