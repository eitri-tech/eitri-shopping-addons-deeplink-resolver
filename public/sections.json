									},
									"sort": {
										"title": "Sort",
										"description": "Items order",
										"default": "score:desc",
										"enum": [
											"discount:desc",
											"name:asc",
											"name:desc",
											"orders:desc",
											"price:asc",
											"price:desc",
											"release:desc",
											"score:desc"
